# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
#
# The app boots and works without any of this. Upload, profiling, data-quality
# checks, SQL execution, charts, anomaly detection, forecasting, the auto
# dashboard and report export are all deterministic. A key is needed only for
# natural-language questions and narrated insights.
# ---------------------------------------------------------------------------

# ---- LLM provider: gemini | groq | openai | none ----
LLM_PROVIDER=gemini
LLM_API_KEY=

# Model. Defaults per provider if left blank:
#   gemini -> gemini-3.6-flash
#   groq   -> llama-3.3-70b-versatile
#   openai -> gpt-4o-mini
LLM_MODEL=gemini-3.5-flash

# Fallback chain, tried in order when the preferred model is out of quota.
#
# Why this exists, measured against the live API: the Gemini free tier enforces
# GenerateRequestsPerDayPerProjectPerModel-FreeTier = 20 requests per day, PER
# MODEL. One analytical question costs 4-8 requests, so a single model gives
# roughly two questions a day. The quota is per model, so a chain multiplies the
# available headroom. The model that actually answered is recorded in the trace,
# so a Flash-Lite answer is never mistaken for a frontier-model answer.
#
# Gemini 3 Pro (gemini-3.1-pro-preview, gemini-3-pro-preview) returns HTTP 429
# immediately on a free key — Pro models have no free-tier quota at all. Put one
# first here once billing is enabled.
LLM_FALLBACK_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-2.5-flash

# Used for cheap classification-style calls.
LLM_FAST_MODEL=gemini-3.1-flash-lite

# Gemini 3.x only: minimal | low | medium | high.
# Gemini 3 deprecated temperature/top_p/top_k in favour of this, so the provider
# omits those fields entirely for 3.x models and sends thinkingLevel instead.
LLM_THINKING_LEVEL=medium

# Applies to Gemini 2.x, Groq and OpenAI only. 0.0 keeps SQL deterministic.
LLM_TEMPERATURE=0.0

LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=3
# Cap on how long a single 429 backoff will wait. Gemini reports the exact delay
# it wants in a RetryInfo detail; that value is honoured up to this ceiling.
LLM_MAX_RETRY_WAIT_S=60

# ---- Ingestion limits ----
MAX_UPLOAD_MB=2000
MAX_FILES_PER_SESSION=10
PROFILE_SAMPLE_ROWS=50000

# ---- Query guard ----
MAX_RESULT_ROWS=5000
QUERY_TIMEOUT_S=30

# ---- Agent ----
# Bounds cost per question. Each step is one LLM request.
MAX_AGENT_STEPS=6
HISTORY_TURNS=6

# ---- Cache ----
# Keyed on question + schema fingerprint, so a cached answer can never be served
# against a different dataset.
CACHE_ENABLED=true
CACHE_TTL_S=3600
CACHE_MAX_ENTRIES=256

# ---- API ----
API_BASE_URL=http://localhost:8000
# Leave blank to disable auth. When set, every endpoint except /health requires
# an X-API-Key header. Set this if you expose the API beyond localhost.
APP_API_KEY=

# ---- Observability ----
LOG_LEVEL=INFO
# true -> one JSON object per line (production). false -> coloured dev output.
LOG_JSON=true
